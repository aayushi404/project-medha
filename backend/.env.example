DATABASE_URL=postgresql+psycopg2://shiksha:shiksha_dev_password@localhost:5431/shiksha_sathi

# generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=changeme

# exact origin of the frontend, no trailing slash
FRONTEND_ORIGIN=http://localhost:3000

# development | production
ENVIRONMENT=development
# refresh cookie: local dev -> secure=true (localhost is a secure context),
# samesite=lax. Production (Vercel <-> Render, cross-site) -> secure=true,
# samesite=none.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# log level for the root logger (DEBUG, INFO, WARNING, ...)
LOG_LEVEL=INFO

# --- Phase 1 ---

# LLM -- provider is swappable (see backend/src/backend/llm/)
LLM_PROVIDER=gemini            # gemini | claude

# Gemini (current: free-tier)
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-flash-lite-latest

# Claude (unused while LLM_PROVIDER=gemini)
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-5

# Embeddings (retrieval grounding) -- see docs/phase-1/04-llm-client-and-retrieval.md
# Default: Voyage AI voyage-3 (1024-dim). Alternative: OpenAI
# text-embedding-3-small (set EMBEDDING_DIM=1536 and skip the vector-column ALTER).
EMBEDDING_API_KEY=...
EMBEDDING_MODEL=voyage-3
EMBEDDING_DIM=1024

# Chat rate limits (per teacher)
CHAT_RATE_LIMIT_PER_MIN=6
CHAT_RATE_LIMIT_PER_DAY=200

# Sarvam AI — voice (STT + TTS). Get a key at https://www.sarvam.ai
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
# Bihari-flavoured Hindi voice (Bulbul v3 speaker + slower pace)
SARVAM_TTS_SPEAKER_BIHARI=ritu
SARVAM_TTS_PACE_BIHARI=0.92

# Google sign-in. This is the WEB client ID from Google Cloud Console (used as
# the audience to verify ID tokens) -- mobile apps get their own Android/iOS
# OAuth client IDs, but pass this one as the `serverClientId` so the token
# they produce is audienced for the backend, not just the device. Leave unset
# to disable Google sign-in (POST /auth/google returns 503 until set).
GOOGLE_CLIENT_ID=

# Firebase Cloud Messaging (push notifications). Path to a service-account
# JSON (Firebase console -> Project settings -> Service accounts -> Generate
# new private key). Keep it out of git -- see backend/.gitignore's /secrets/
# entry. Leave unset and push silently no-ops; the in-app notification inbox
# always works regardless.
FIREBASE_CREDENTIALS_PATH=

# Absence calling: instant guardian phone call + AI voice conversation when a
# teacher marks a student absent (see backend/src/backend/absence_calls/).
# Off by default -- flip on only once the chosen provider below is fully
# configured, so a fresh/dev deployment never dials real numbers by accident.
ABSENCE_CALLING_ENABLED=false

# Which provider places the call -- twilio | exotel.
# twilio: no business KYC, works today, but a trial account can only call
#   numbers you've verified in the Twilio console (fine for a demo).
# exotel: needs KYC approved first (can take a few days), no such
#   per-call restriction once approved -- the production-grade choice.
TELEPHONY_PROVIDER=twilio

# Twilio (https://twilio.com). Account SID + Auth Token from the Console
# dashboard (twilio.com/console). Twilio does not sell local Indian numbers,
# so TWILIO_CALLER_NUMBER will usually be a US/UK number -- test call
# quality to a real Indian mobile before relying on it for a demo.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_CALLER_NUMBER=            # E.164, e.g. +14155551234
# Shared secret checked on Twilio's status-callback webhook
# (POST /absence-calls/twilio/status-callback?token=...).
TWILIO_WEBHOOK_TOKEN=

# Exotel (Indian cloud telephony -- https://exotel.com). SID/API key/token from
# the Exotel dashboard (Settings -> API Settings).
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.in.exotel.com   # Mumbai; use api.exotel.com for Singapore
# Your ExoPhone (the number calls are placed from).
EXOTEL_CALLER_ID=
# The Exotel "App" (Flow) with a Voicebot Applet configured -- create this
# once in Exotel's App Bazaar, pointing the applet's websocket endpoint at
# {PUBLIC_BASE_URL}/absence-calls/exotel/voicebot. There's no API for
# creating this; it's a one-time manual dashboard step.
EXOTEL_APP_ID=
# Shared secret checked on Exotel's status-callback webhook
# (POST /absence-calls/exotel/status-callback?token=...) -- Exotel doesn't
# sign these by default. Generate with the same secrets.token_hex(32) as above.
EXOTEL_WEBHOOK_TOKEN=

# This server's own publicly reachable origin (e.g. the Render URL, or an
# ngrok tunnel in local dev) -- used when building the webhook/websocket URLs
# the telephony provider calls back into. No trailing slash.
PUBLIC_BASE_URL=

# A separate Gemini API key for the absence-call conversation itself, kept
# apart from GEMINI_API_KEY above (the rest of the app's LLM key) so a live
# phone call's usage/quota is tracked -- and can't be starved by -- lesson
# generation and chat, in either direction. Get one the same way (a second
# key from the same or a different Google account, aistudio.google.com/apikey).
ABSENCE_CALL_GEMINI_API_KEY=
ABSENCE_CALL_GEMINI_MODEL=gemini-flash-lite-latest

//