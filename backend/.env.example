DATABASE_URL=postgresql+psycopg2://shiksha:shiksha_dev_password@localhost:5431/shiksha_sathi

# generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=changeme

# exact origin of the frontend, no trailing slash
FRONTEND_ORIGIN=http://localhost:3000

# development | production
ENVIRONMENT=development
# refresh cookie: local dev -> secure=true (localhost is a secure context),
# samesite=lax. Production (Vercel <-> Render, cross-site) -> secure=true,
# samesite=none.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# log level for the root logger (DEBUG, INFO, WARNING, ...)
LOG_LEVEL=INFO

# --- Phase 1 ---

# LLM -- provider is swappable (see backend/src/backend/llm/)
LLM_PROVIDER=gemini            # gemini | claude

# Gemini (current: free-tier)
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-flash-lite-latest

# Claude (unused while LLM_PROVIDER=gemini)
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-5

# Embeddings (retrieval grounding) -- see docs/phase-1/04-llm-client-and-retrieval.md
# Default: Voyage AI voyage-3 (1024-dim). Alternative: OpenAI
# text-embedding-3-small (set EMBEDDING_DIM=1536 and skip the vector-column ALTER).
EMBEDDING_API_KEY=...
EMBEDDING_MODEL=voyage-3
EMBEDDING_DIM=1024

# Chat rate limits (per teacher)
CHAT_RATE_LIMIT_PER_MIN=6
CHAT_RATE_LIMIT_PER_DAY=200

# Sarvam AI — voice (STT + TTS). Get a key at https://www.sarvam.ai
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
