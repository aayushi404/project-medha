DATABASE_URL=postgresql+psycopg2://shiksha:shiksha_dev_password@localhost:5431/shiksha_sathi

# generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=changeme

# exact origin of the frontend, no trailing slash
FRONTEND_ORIGIN=http://localhost:3000

# development | production
ENVIRONMENT=development
# refresh cookie: local dev -> secure=true (localhost is a secure context),
# samesite=lax. Production (Vercel <-> Render, cross-site) -> secure=true,
# samesite=none.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# log level for the root logger (DEBUG, INFO, WARNING, ...)
LOG_LEVEL=INFO

# --- Phase 1 ---

# LLM -- provider is swappable (see backend/src/backend/llm/)
LLM_PROVIDER=gemini            # gemini | claude

# Gemini (current: free-tier)
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-flash-lite-latest

# Claude (unused while LLM_PROVIDER=gemini)
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-5

# Embeddings (retrieval grounding) -- see docs/phase-1/04-llm-client-and-retrieval.md
# Default: Voyage AI voyage-3 (1024-dim). Alternative: OpenAI
# text-embedding-3-small (set EMBEDDING_DIM=1536 and skip the vector-column ALTER).
EMBEDDING_API_KEY=...
EMBEDDING_MODEL=voyage-3
EMBEDDING_DIM=1024

# Chat rate limits (per teacher)
CHAT_RATE_LIMIT_PER_MIN=6
CHAT_RATE_LIMIT_PER_DAY=200

# Sarvam AI — voice (STT + TTS). Get a key at https://www.sarvam.ai
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
# Bihari-flavoured Hindi voice (Bulbul v3 speaker + slower pace)
SARVAM_TTS_SPEAKER_BIHARI=ritu
SARVAM_TTS_PACE_BIHARI=0.92

# Google sign-in. This is the WEB client ID from Google Cloud Console (used as
# the audience to verify ID tokens) -- mobile apps get their own Android/iOS
# OAuth client IDs, but pass this one as the `serverClientId` so the token
# they produce is audienced for the backend, not just the device. Leave unset
# to disable Google sign-in (POST /auth/google returns 503 until set).
GOOGLE_CLIENT_ID=

# Firebase Cloud Messaging (push notifications). Path to a service-account
# JSON (Firebase console -> Project settings -> Service accounts -> Generate
# new private key). Keep it out of git -- see backend/.gitignore's /secrets/
# entry. Leave unset and push silently no-ops; the in-app notification inbox
# always works regardless.
FIREBASE_CREDENTIALS_PATH=
